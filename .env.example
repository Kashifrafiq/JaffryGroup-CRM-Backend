PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=crm_backend
DB_SYNCHRONIZE=true
DB_RUN_MIGRATIONS=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=ghj
JWT_EXPIRES_IN=30d

ADMIN_EMAIL=kashif@vanestone.tech
ADMIN_PASSWORD=123K@shif

# Space name
AWS_S3_BUCKET=your-space-name

# Same region slug as in the endpoint (e.g. nyc3, ams3, sgp1)
AWS_REGION=nyc3

# Spaces → API → Spaces Keys (not your DO account password)
AWS_ACCESS_KEY_ID=your_spaces_key
AWS_SECRET_ACCESS_KEY=your_spaces_secret

# Required for DigitalOcean (not for default AWS S3). Use the regional base only — not
# https://<space-name>.nyc3.digitaloceanspaces.com (that breaks TLS / double-bucket hostnames).
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Invite emails (associate + customer) — Nodemailer SMTP
# MX for jafrigroup.ca → mail.jafrigroup.ca (confirm port/TLS with your host)
SMTP_HOST=mail.jafrigroup.ca
# Use 465 (SSL) or 587 (STARTTLS). Do not use 993 — that is IMAP, not SMTP.
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@jafrigroup.ca
SMTP_PASS=your-mailbox-password
SMTP_FROM="Jaffry Group <info@jafrigroup.ca>"

# Invite link bases (frontend URLs)
FRONTEND_INVITE_URL_BASE=https://your-frontend.com/associate-invite
FRONTEND_CUSTOMER_INVITE_URL_BASE=https://your-frontend.com/customer-invite
CUSTOMER_INVITE_EXPIRES_HOURS=48
ASSOCIATE_INVITE_EXPIRES_HOURS=48
